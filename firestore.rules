rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users may read their own profile. Only an already verified admin can
    // create/update user profiles through the client. Seed the first admin
    // manually in the Firebase Console; do not let users self-assign roles.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if isAdmin();
    }

    // Class records are managed only by an admin. Signed-in users may read
    // class names; student data is not stored in this collection.
    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Deny all other collections until their specific access rules are built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}